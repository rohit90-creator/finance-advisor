# Copy this file to .env and fill in your own values. Never commit .env.

# Long random string used to sign login sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Currency symbol shown in the app (rupee amounts use Indian digit grouping)
CURRENCY_SYMBOL=₹

# Set to 1 while developing (auto-reload and detailed errors). Use 0 for demos.
FLASK_DEBUG=1

# Set to 1 when the site is served over HTTPS (Render, ngrok https URL)
SESSION_COOKIE_SECURE=0

# Optional: use another database instead of the local SQLite file
# DATABASE_URL=sqlite:///instance/finance.db
